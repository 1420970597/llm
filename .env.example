APP_ENV=development
APP_ALLOWED_ORIGIN=*
APP_ENCRYPTION_KEY=phase1-dev-only-32-byte-secret!!!
API_PORT=8080
WORKER_PORT=8081
WEB_USER_PORT=3210
WEB_ADMIN_PORT=3211
POSTGRES_DB=llm_factory
POSTGRES_USER=llm_factory
POSTGRES_PASSWORD=llm_factory_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=15432
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=16379

# 旧任务队列（dataset 中心）。API 与 worker 必须同名，否则任务不会被消费。
WORKER_QUEUE_NAME=dataset-generation
# Atelier 新作业（studio.*）队列（Issue #160 T06）。留空则自动取
# WORKER_QUEUE_NAME + "-studio"，因此只需要一个变量也不要紧。
# **不要**把它设成与 WORKER_QUEUE_NAME 相同：旧消费者不认识
# {schemaVersion, jobId}，两者同名会让新作业在旧消费者里被丢掉。
# WORKER_STUDIO_QUEUE_NAME=dataset-generation-studio
# 单进程同时执行的 Studio 作业数（上限 8）。批次内部的并发由该批次的
# generation_config.concurrency 决定，这个值只控制「同时几个批次在跑」。
# WORKER_STUDIO_CONCURRENCY=2
S3_BUCKET=llm-factory-dev
S3_ENDPOINT=http://minio:9000
S3_EXTERNAL_PORT=19000
S3_CONSOLE_EXTERNAL_PORT=19001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# 结果存储引导（issue #83）
# 全新部署下 storage_profiles 表为空，而答案/评分/导出三个阶段都要写对象存储。
# 开启后，api 首次启动会幂等写入一条默认结果存储配置，使全新部署开箱可用。
# 置为 false 可关闭（关闭后需在「系统设置 → 结果存储」手工配置，否则上述三个阶段会失败）。
APP_BOOTSTRAP_STORAGE_ENABLED=true
APP_BOOTSTRAP_STORAGE_NAME=默认结果存储
